# Copy to .env only if your process manager loads it. This zero-dependency MVP
# reads environment variables and never reads or serves this file itself.
DASHSCOPE_API_KEY=replace-me
DASHSCOPE_WORKSPACE_ID=replace-me

# OpenAI-compatible base URL for Qwen text analysis (without /chat/completions).
DASHSCOPE_LLM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_LLM_MODEL=qwen3.7-flash

# Non-realtime TTS defaults. The endpoint is derived from WORKSPACE_ID unless
# explicitly set here.
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
# DASHSCOPE_TTS_ENDPOINT=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer

APP_MAX_ANALYZE_CHARACTERS=50000
APP_MAX_RENDER_CHARACTERS=20000
DASHSCOPE_TIMEOUT_SECONDS=60

